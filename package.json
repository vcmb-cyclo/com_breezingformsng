{
  "name": "com-breezingformsng-ci",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CI tooling for BreezingForms NG",
  "scripts": {
    "lint": "npm run lint:css && npm run lint:js && npm run lint:inline-scripts && npm run vendor:check",
    "lint:css": "stylelint \"media/com_breezingformsng/css/**/*.css\"",
    "lint:js": "eslint media/com_breezingformsng/js scripts tests/JavaScript tests/Browser tests/E2E eslint.config.mjs playwright.config.mjs playwright.e2e.config.mjs stylelint.config.mjs",
    "lint:inline-scripts": "node scripts/check-inline-scripts.mjs",
    "lint:css:fix": "stylelint \"media/com_breezingformsng/css/**/*.css\" --fix",
    "test:tree-model": "node --test tests/JavaScript/quickmode-tree-model.test.mjs",
    "test:container-log": "node --test tests/JavaScript/container-log.test.mjs",
    "test:browser": "playwright test",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "test:vendor": "node --test tests/JavaScript/vendor-sync.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {
    "jstree": "3.3.17",
    "sweetalert2": "11.26.25"
  }
}
