{
    "name": "vcmb/com_breezingformsng-dev",
    "description": "Dev tooling (PHPUnit) for com_breezingformsng - not part of the installable Joomla package",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpstan/phpstan": "^2.2.11",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Vcmb\\Component\\BreezingformsNG\\Administrator\\": "administrator/components/com_breezingformsng/src/",
            "Vcmb\\Component\\BreezingformsNG\\Site\\": "components/com_breezingformsng/src/",
            "Vcmb\\Component\\BreezingformsNG\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "lint:php": "phpcs --standard=phpcs.xml.dist",
        "lint:php:fix": "phpcbf --standard=phpcs.xml.dist"
    }
}
