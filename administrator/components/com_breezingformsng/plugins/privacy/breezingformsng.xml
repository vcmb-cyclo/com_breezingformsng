<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="privacy" method="upgrade">
	<name>PLG_PRIVACY_BREEZINGFORMSNG</name>
	<author>XDA/GIL</author>
	<creationDate>2026-10-12</creationDate>
	<copyright>Copyright 2024 - 2026 by XDA+GIL</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.1.0-RC10</version>
	<description>PLG_PRIVACY_BREEZINGFORMSNG_XML_DESCRIPTION</description>
	<namespace path="src">Vcmb\Plugin\Privacy\Breezingformsng</namespace>
	<files>
		<folder plugin="breezingformsng">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<languages folder="language">
		<language tag="de-DE">de-DE/plg_privacy_breezingformsng.ini</language>
		<language tag="de-DE">de-DE/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="en-GB">en-GB/plg_privacy_breezingformsng.ini</language>
		<language tag="en-GB">en-GB/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="es-ES">es-ES/plg_privacy_breezingformsng.ini</language>
		<language tag="es-ES">es-ES/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="fr-FR">fr-FR/plg_privacy_breezingformsng.ini</language>
		<language tag="fr-FR">fr-FR/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="hu-HU">hu-HU/plg_privacy_breezingformsng.ini</language>
		<language tag="hu-HU">hu-HU/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="it-IT">it-IT/plg_privacy_breezingformsng.ini</language>
		<language tag="it-IT">it-IT/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="nl-NL">nl-NL/plg_privacy_breezingformsng.ini</language>
		<language tag="nl-NL">nl-NL/plg_privacy_breezingformsng.sys.ini</language>
		<language tag="tr-TR">tr-TR/plg_privacy_breezingformsng.ini</language>
		<language tag="tr-TR">tr-TR/plg_privacy_breezingformsng.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="remove_records"
					type="radio"
					label="PLG_PRIVACY_BREEZINGFORMSNG_REMOVE_RECORDS_LABEL"
					description="PLG_PRIVACY_BREEZINGFORMSNG_REMOVE_RECORDS_DESC"
					layout="joomla.form.field.radio.switcher"
					default="0"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
