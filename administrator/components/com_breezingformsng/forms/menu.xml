<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Vcmb\Component\BreezingformsNG\Administrator\Field">
	<fieldset name="details" label="COM_BREEZINGFORMSNG_MENUS_EDIT">
		<field
			name="id"
			type="hidden"
			filter="integer"
		/>
		<field
			name="img"
			type="hidden"
		/>
		<field
			name="title"
			type="text"
			label="COM_BREEZINGFORMSNG_MENUS_TITLE"
			description="COM_BREEZINGFORMSNG_MENUS_TIPTITLE"
			required="true"
		/>
		<field
			name="name"
			type="text"
			label="COM_BREEZINGFORMSNG_MENUS_NAME"
			description="COM_BREEZINGFORMSNG_MENUS_TIPNAME"
		/>
		<field
			name="package"
			type="text"
			label="COM_BREEZINGFORMSNG_MENUS_PACKAGE"
		/>
		<field
			name="parent"
			type="menuparent"
			label="COM_BREEZINGFORMSNG_MENUS_PARENT"
			default="0"
			filter="integer"
			>
			<option value="0">COM_BREEZINGFORMSNG_MENUS_TOP</option>
		</field>
		<field
			name="page"
			type="number"
			label="COM_BREEZINGFORMSNG_MENUS_PAGE"
			default="1"
			min="1"
			filter="integer"
		/>
		<field
			name="published"
			type="radio"
			label="JPUBLISHED"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="frame"
			type="radio"
			label="COM_BREEZINGFORMSNG_MENUS_FRAME"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="border"
			type="radio"
			label="COM_BREEZINGFORMSNG_MENUS_BORDER"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="params"
			type="textarea"
			label="COM_BREEZINGFORMSNG_MENUS_PARAMS"
			rows="4"
			filter="raw"
		/>
	</fieldset>
</form>
