<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Vcmb\Component\BreezingformsNG\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="JSEARCH_FILTER"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="package"
			type="Packagefilter"
			source="forms"
			label="COM_BREEZINGFORMSNG_FORMS_PACKAGE"
			class="js-select-submit-on-change"
			>
			<option value="">COM_BREEZINGFORMSNG_ALL_PACKAGES</option>
			<option value="__none__">COM_BREEZINGFORMSNG_NO_PACKAGE</option>
		</field>
		<field
			name="published"
			type="status"
			label="JSTATUS"
			optionsFilter="*,-2,0,1"
			class="js-select-submit-on-change"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
