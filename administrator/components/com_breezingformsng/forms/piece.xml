<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field
			name="id"
			type="hidden"
			filter="integer"
		/>
		<field
			name="title"
			type="text"
			label="COM_BREEZINGFORMSNG_PIECES_TITLE"
			description="COM_BREEZINGFORMSNG_PIECES_TIPTITLE"
			maxlength="50"
			required="true"
		/>
		<field
			name="name"
			type="text"
			label="COM_BREEZINGFORMSNG_PIECES_NAME"
			description="COM_BREEZINGFORMSNG_PIECES_TIPNAME"
			maxlength="30"
			required="true"
			pattern="\w+"
		/>
		<field
			name="type"
			type="list"
			label="COM_BREEZINGFORMSNG_PIECES_TYPE"
			description="COM_BREEZINGFORMSNG_PIECES_TIPTYPE"
			default="Untyped"
			validate="options"
			>
			<option value="Untyped">COM_BREEZINGFORMSNG_PIECES_UNTYPED</option>
			<option value="Before Form">COM_BREEZINGFORMSNG_PIECES_BEFOREFORM</option>
			<option value="After Form">COM_BREEZINGFORMSNG_PIECES_AFTERFORM</option>
			<option value="Begin Submit">COM_BREEZINGFORMSNG_PIECES_BEGINSUBMIT</option>
			<option value="End Submit">COM_BREEZINGFORMSNG_PIECES_ENDSUBMIT</option>
		</field>
		<field
			name="package"
			type="text"
			label="COM_BREEZINGFORMSNG_PIECES_PACKAGE"
			description="COM_BREEZINGFORMSNG_PIECES_TIPPACKAGE"
			maxlength="30"
		/>
		<field
			name="published"
			type="radio"
			label="COM_BREEZINGFORMSNG_PIECES_PUBLISHED"
			description="COM_BREEZINGFORMSNG_PIECES_TIPPUBLISHED"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="description"
			type="textarea"
			label="COM_BREEZINGFORMSNG_PIECES_DESCRIPTION"
			description="COM_BREEZINGFORMSNG_PIECES_TIPDESCRIPTION"
			rows="6"
			filter="raw"
		/>
	</fieldset>
	<fieldset name="code">
		<field
			name="code"
			type="editor"
			label="COM_BREEZINGFORMSNG_PIECES_CODE"
			description="COM_BREEZINGFORMSNG_PIECES_TIPCODE"
			editor="codemirror"
			syntax="php"
			buttons="false"
			height="300"
			filter="raw"
		/>
		<field
			name="unit_tests"
			type="textarea"
			label="COM_BREEZINGFORMSNG_TEST_UNIT_TESTS"
			description="COM_BREEZINGFORMSNG_TEST_UNIT_TESTS_HELP"
			rows="8"
			filter="raw"
		/>
	</fieldset>
</form>
