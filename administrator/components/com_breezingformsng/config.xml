<?xml version="1.0" encoding="utf-8"?>
<config addfieldprefix="Vcmb\Component\BreezingformsNG\Administrator\Field">
    <fieldset
        name="general"
        label="COM_BREEZINGFORMSNG_CONFIG_FIELDSET_GENERAL"
    >
        <field
            name="disable_ip"
            type="radio"
            label="COM_BREEZINGFORMSNG_CONFIG_DISABLE_IP_ADDRESS_STORING"
            description="COM_BREEZINGFORMSNG_CONFIG_DISABLE_IP_ADDRESS_STORING"
            layout="joomla.form.field.radio.switcher"
            default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field
            name="emailadr"
            type="text"
            label="COM_BREEZINGFORMSNG_CONFIG_DEFAULTEMAIL"
            description="COM_BREEZINGFORMSNG_CONFIG_DEFAULTEMAIL_TIP"
            default="Enter your email address here"
            size="60"
        />
        <field
            name="uploads"
            type="text"
            label="COM_BREEZINGFORMSNG_CONFIG_FFUPLOADS"
            description="COM_BREEZINGFORMSNG_CONFIG_FFUPLOADS_TIP"
            default="{mospath}/media/breezingforms/uploads"
            size="70"
        />
    </fieldset>
    <fieldset
        name="csv"
        label="COM_BREEZINGFORMSNG_CONFIG_CSV_FIELDSET"
    >
        <field
            name="csvdelimiter"
            type="text"
            label="COM_BREEZINGFORMSNG_CONFIG_CSVDELIMITER"
            description="COM_BREEZINGFORMSNG_CONFIG_CSVDELIMITER_TIP"
            default=";"
            maxlength="1"
            size="2"
        />
        <field
            name="csvquote"
            type="text"
            label="COM_BREEZINGFORMSNG_CONFIG_CSVQUOTE"
            description="COM_BREEZINGFORMSNG_CONFIG_CSVQUOTE_TIP"
            default="&quot;"
            maxlength="1"
            size="2"
        />
        <field
            name="cellnewline"
            type="radio"
            label="COM_BREEZINGFORMSNG_CONFIG_CSVQUOTENEWLINE"
            description="COM_BREEZINGFORMSNG_CONFIG_CSVQUOTENEWLINE_TIP"
            default="1"
            layout="joomla.form.field.radio.switcher"
        >
            <option value="0">COM_BREEZINGFORMSNG_CONFIG_CSVQUOTENEWLINE_REGULAR</option>
            <option value="1">COM_BREEZINGFORMSNG_CONFIG_CSVQUOTENEWLINE_QUOTED</option>
        </field>
    </fieldset>
    <fieldset
        name="package_transfer"
        label="COM_BREEZINGFORMSNG_IMPORT_EXPORT"
    >
        <field
            name="package_transfer"
            type="packagetransfer"
            label="COM_BREEZINGFORMSNG_IMPORT_EXPORT"
            filter="unset"
        />
    </fieldset>
    <fieldset
        name="permissions"
        label="JCONFIG_PERMISSIONS_LABEL"
        description="JCONFIG_PERMISSIONS_DESC"
    >
        <field
            name="rules"
            type="rules"
            label="JCONFIG_PERMISSIONS_LABEL"
            class="inputbox"
            validate="rules"
            filter="rules"
            component="com_breezingformsng"
            section="component"
        />
    </fieldset>
</config>
